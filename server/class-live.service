[Unit]
Description=Tufts Class Explorer live enrollment proxy
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/class-live/proxy.py
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
